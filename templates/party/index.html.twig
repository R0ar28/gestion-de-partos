{% extends 'base.html.twig' %}

{% block title %}Entidades{% endblock %}

{% block body %}

    <div class="modal fade" id="kt_modal_create_app" tabindex="-1" style="display: none;" aria-hidden="true">
        <!--begin::Modal dialog-->
        <div class="modal-dialog modal-dialog-centered mw-900px">
            <!--begin::Modal content-->
            <div class="modal-content">

                <div class="modal-header">

                    <h2>Nuevo Documento</h2>

                    <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">

                        <span class="svg-icon svg-icon-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1"
                                      transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                                <rect x="7.41422" y="6" width="16" height="2" rx="1"
                                      transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
                            </svg>
                        </span>
                    </div>

                </div>

                <div class="modal-body  ">

                    <div class="row">
                        <div class="col-md-12">

                            <form id="party-form" action="{{ path('app_new_party') }}" method="POST">

                                <!-- party create section -->
                                <div class="card card-dashed p-4 mb-3">
                                    <div class="text-center mb-4">
                                        <h5 class="mb-0">Asignar Entidad</h5>
                                    </div>
                                    <div class="row g-3">

                                        <div class="col-md-12">
                                            <label for="party-name" class="form-label required"> Nombre de la
                                                Entidad </label>
                                            <input type="text" class="form-control" id="party-name"
                                                   name="party-name"
                                                   placeholder="Ingrese el nombre completo" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="party-identifier"
                                                   class="form-label required">Identificador </label>
                                            <input type="text" class="form-control" id="party-identifier"
                                                   name="party-identifier"
                                                   placeholder="Ingresar Identificador" required>
                                        </div>


                                        <div class="col-md-6">
                                            <label for="party-id-type" class="form-label required">Tipo de Identificador
                                            </label>
                                            <select class="form-select" id="party-id-type" name="party-id-type"
                                                    required>
                                                <option value="" selected disabled>Seleccione...</option>
                                                {% for identificationType in identificationTypes %}
                                                    <option
                                                        value="{{ identificationType.id }}">{{ identificationType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <!-- Tipo de Entidad -->
                                        <div class="col-md-12">
                                            <label for="party-type" class="form-label required">Tipo de Entidad </label>
                                            <select class="form-select" id="party-type" name="party-type" required>
                                                <option value="" selected disabled>Seleccione...</option>
                                                {% for partyType in partyTypes %}
                                                    <option value="{{ partyType.id }}">{{ partyType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <div class="float-end">
                                            <a href="javascript:void(0)" class="btn text-muted" id="add-user-party"> <i
                                                    class="fas fa-plus"></i> Agregar Usuario </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- end party create section -->

                                <!-- user create section -->
                                <div class="card card-dashed p-4 mb-3 d-none" id="card-user">
                                    <div class="text-center mb-4">
                                        <h5 class="mb-0">Creacion de Usuario</h5>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="party-email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="party-email"
                                               name="party-email"
                                               placeholder="correo@ejemplo.com">
                                    </div>

                                    <!-- Teléfono (opcional) -->
                                    <div class="col-md-6">
                                        <label for="party-phone" class="form-label">Teléfono</label>
                                        <input type="tel" class="form-control" id="party-phone"
                                               name="party-phone"
                                               placeholder="+56 9 1234 5678">
                                    </div>

                                    <!-- Dirección (opcional) -->
                                    <div class="col-md-12">
                                        <label for="party-address" class="form-label">Dirección</label>
                                        <textarea class="form-control" id="party-address" name="party-address"
                                                  rows="2" placeholder="Calle, número, ciudad"></textarea>
                                    </div>
                                </div>

                                <!-- end user create section -->

                                <div class="col-md-12">
                                    <div class="d-flex gap-2 justify-content-end mt-3">
                                        <button type="button" class="btn btn-secondary" id="btn-cancel">
                                            Cancelar
                                        </button>
                                        <button type="submit" class="btn btn-primary" id="btn-save">
                                            Guardar Entidad
                                        </button>
                                    </div>
                                </div>
                            </form>


                        </div>
                    </div>


                </div>
                <!--end::Modal body-->
            </div>
            <!--end::Modal content-->
        </div>
        <!--end::Modal dialog-->
    </div>

    <div class="content flex-row-fluid" id="kt_content">
        <!--begin::Navbar-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body pt-9 pb-0 p-4">
                <div class="container-fluid">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <div
                                class="d-flex flex-wrap flex-sm-nowrap justify-content-end align-items-center mb-3 mb-xl-0">
                                <button class="btn btn-secondary btn-sm" data-bs-toggle="modal"
                                        data-bs-target="#kt_modal_create_app"><i class="fas fa-plus"></i> Agregar
                                    Entidad
                                </button>

                            </div>
                        </div>

                        <div class="container my-4">
                            <div class="row g-3">

                                <div class="card-body">

                                    <!-- Tabs por rol -->
                                    <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x mb-5 fs-6">
                                        {% for partyType in partyTypes %}

                                            <li class="nav-item">
                                                <a class="nav-link
                                                        {% if loop.first %}
                                                            active
                                                        {% endif %}"
                                                   data-bs-toggle="tab"
                                                   href="#tab_party_type_{{ partyType.id }}">{{ partyType.name }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>

                                    <div class="tab-content">
                                        {% for partyType in partyTypes %}

                                            <div class="tab-pane fade
                                                {% if loop.first %}
                                                    show active
                                                {% endif %}" id="tab_party_type_{{ partyType.id }}"
                                                 partyType="tabpanel">

                                                {% set typeOfParty = parties[partyType.id].parties %}

                                                {% if typeOfParty is empty %}
                                                    <div class="card">
                                                        <div class="card-body text-center">
                                                            <h5 class="card-title">No hay Entidades</h5>
                                                            <p class="card-text"> No hay entidades asociadas a este
                                                                tipo </p>
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <div class="table-responsive">
                                                        <table id="tabUser_{{ partyType.id }}"
                                                               class="table table-hover table-striped table-row-bordered gy-5 stylish-table mb-0 mt-2">
                                                            <thead>
                                                            <tr class="fw-semibold fs-6 text-muted">
                                                                <th>ID</th>
                                                                <th>Nombre</th>
                                                                <th>Identificador</th>
                                                                <th>Tipo de Identificador</th>
                                                                <th>Estado</th>
                                                                <th>Opciones</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            {% for party in typeOfParty %}
                                                                <tr class="jusitfy-content-center d-flow">
                                                                    <td>{{ party.id }}</td>
                                                                    <td>
                                                                        <div class="d-flex align-items-center">
                                                                            <div
                                                                                class="d-flex justify-content-start flex-column">
                                                                            <span
                                                                                class="text-dark fw-bold text-hover-primary fs-6 text-start">
                                                                                {{ party.name }}
                                                                            </span>
                                                                                <span
                                                                                    class="text-muted fw-semibold d-block fs-7 text-start">
                                                                            {% if party.activeInd or party.active_ind %}
                                                                                <i class="fa fa-check-circle"
                                                                                   style="color: #50CD89;"></i> Activado
                                                                            {% else %}
                                                                                <i class="fa fa-window-close"
                                                                                   style="color: darkred;"></i> Desactivado
                                                                            {% endif %}
                                                                        </span>
                                                                            </div>
                                                                        </div>
                                                                    </td>
                                                                    <td>{{ party.identification }}</td>
                                                                    <td>{{ party.identificationType.name }}</td>
                                                                    <td>
                                                                        {{ party.activeInd ? 'Activo' : 'Inactivo' }}
                                                                    </td>
                                                                    <td>
                                                                        <a type="button"
                                                                           class="btn btn-secondary editbtn"
                                                                           data-id="{{ party.id }}">
                                                                            <i class="bi bi-pencil-square"></i>
                                                                            Editar
                                                                        </a>
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



{% endblock %}
