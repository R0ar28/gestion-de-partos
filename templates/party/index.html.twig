{% extends 'base.html.twig' %}

{% block title %}Entidades{% endblock %}

{% set partyActive = 'active' %}

{% block breadBottom %}
    <button class="btn btn-secondary" data-bs-toggle="modal"
            data-bs-target="#kt_modal_create_app"><i class="fas fa-plus"></i> Agregar
        Entidad
    </button>
{% endblock %}

{% block body %}

    <div class="modal fade" id="kt_modal_create_app" tabindex="-1" style="display: none;" aria-hidden="true">
        <!--begin::Modal dialog-->
        <div class="modal-dialog modal-dialog-centered mw-900px">
            <!--begin::Modal content-->
            <div class="modal-content">

                <div class="modal-header">

                    <h2>Nueva Entidad</h2>

                    <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">

                        <span class="svg-icon svg-icon-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1"
                                      transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                                <rect x="7.41422" y="6" width="16" height="2" rx="1"
                                      transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
                            </svg>
                        </span>
                    </div>

                </div>

                <div class="modal-body  ">

                    <div class="row">
                        <div class="col-md-12">

                            <form id="party-form" action="{{ path('app_new_party') }}" method="POST"
                                  enctype="multipart/form-data">

                                <!-- party create section -->
                                <div class="card card-dashed p-4 mb-3">
                                    <div class="text-center mb-4">
                                        <h5 class="mb-0">Crear Entidad</h5>
                                    </div>
                                    <div class="row g-3">

                                        <div class="col-md-12">
                                            <label for="party-name" class="form-label required"> Nombre de la
                                                Entidad </label>
                                            <input type="text" class="form-control" id="party-name"
                                                   name="party[party_name]"
                                                   placeholder="Ingrese el nombre completo" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="party-identifier"
                                                   class="form-label required">Identificador </label>
                                            <input type="text" class="form-control" id="party-identifier"
                                                   name="party[party_identifier]"
                                                   placeholder="Ingresar Identificador" required>
                                        </div>


                                        <div class="col-md-6">
                                            <label for="party-id-type" class="form-label required">Tipo de Identificador
                                            </label>
                                            <select class="form-select" id="party-id-type" name="party[party_id_type]"
                                                    required>
                                                <option value="" selected disabled>Seleccione...</option>
                                                {% for identificationType in identificationTypes %}
                                                    <option
                                                        value="{{ identificationType.id }}">{{ identificationType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <!-- Tipo de Entidad -->
                                        <div class="col-md-12">
                                            <label for="party-type" class="form-label required">Tipo de Entidad </label>
                                            <select class="form-select" id="party-type" name="party[party_type]"
                                                    required>
                                                <option value="" selected disabled>Seleccione...</option>
                                                {% for partyType in partyTypes %}
                                                    <option value="{{ partyType.id }}">{{ partyType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        {#  <div class="float-end">
                                            <a href="javascript:void(0)" class="btn text-muted" id="add-user-party"> <i
                                                    class="fas fa-plus"></i> Agregar Usuario </a>
                                        </div> #}
                                    </div>
                                </div>

                                <!-- end party create section -->

                                <!-- user create section -->
                                {#   <div class="card card-dashed p-4 mb-3 d-none" id="card-user">
                                    <div class="text-center mb-4">
                                        <h5 class="mb-0">Creación de Usuario</h5>
                                    </div>
                                    <div class="row g-3">

                                        <div class="col-md-12">
                                            <div class="d-flex justify-content-center mb-3">
                                                <div class="user-image-wrapper">
                                                    <img src="{{ asset('media/user.png') }}" alt="Imagen de Usuario"
                                                         id="previewImage">
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-center">
                                                <button type="button" class="btn btn-secondary" id="uploadBtn">
                                                    <i class="fas fa-image"></i> Seleccionar archivo
                                                </button>
                                                <input type="file" id="fileInput" style="display: none;"
                                                       accept="image/*">

                                                <!-- Aquí guardamos el base64 -->
                                                <input type="hidden" name="user[user_avatar]" id="base64Input">
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="user-username" class="form-label">Nombre de Usuario <span
                                                    class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="user-username"
                                                   name="user[user_name]" placeholder="Nombre de Usuario" required>
                                        </div>

                                        <!-- Email -->
                                        <div class="col-md-6">
                                            <label for="user-email" class="form-label">Email <span
                                                    class="text-danger">*</span></label>
                                            <input type="email" class="form-control" id="user-email"
                                                   name="user[user_email]" placeholder="correo@ejemplo.com" required>
                                        </div>

                                        <!-- Roles Section -->
                                        <div class="col-12">
                                            <label class="form-label d-block">Roles <span
                                                    class="text-danger">*</span></label>
                                            <div class="border rounded p-3">
                                                <div class="row">
                                                    {% for role in roles %}
                                                        <div class="col-md-4 mb-2">
                                                            <div class="form-check d-flex align-items-center">
                                                                <input
                                                                    class="form-check-input me-2"
                                                                    type="checkbox"
                                                                    id="role-{{ role.id }}"
                                                                    name="user-roles[]"
                                                                    value="{{ role.id }}">
                                                                <label class="form-check-label mb-0"
                                                                       for="role-{{ role.id }}">
                                                                    {{ role.textName }}
                                                                </label>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                            <small class="text-muted">Selecciona uno o más roles para el usuario</small>
                                        </div>
                                    </div>
                                </div> #}

                                <!-- end user create section -->

                                <div class="col-md-12">
                                    <div class="d-flex gap-2 justify-content-end mt-3">
                                        <button type="button" class="btn btn-secondary" id="btn-cancel">
                                            Cancelar
                                        </button>
                                        <button type="submit" class="btn btn-primary" id="btn-save">
                                            Guardar Entidad
                                        </button>
                                    </div>
                                </div>
                            </form>


                        </div>
                    </div>


                </div>
                <!--end::Modal body-->
            </div>
            <!--end::Modal content-->
        </div>
        <!--end::Modal dialog-->
    </div>

    <div class="modal fade" id="kt_modal_edit_app" tabindex="-1" style="display: none;" aria-hidden="true">
        <!--begin::Modal dialog-->
        <div class="modal-dialog modal-dialog-centered mw-900px">
            <!--begin::Modal content-->
            <div class="modal-content">

                <div class="modal-header">

                    <h2>Editar Entidad</h2>

                    <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">

                        <span class="svg-icon svg-icon-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1"
                                      transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                                <rect x="7.41422" y="6" width="16" height="2" rx="1"
                                      transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
                            </svg>
                        </span>
                    </div>

                </div>

                <div class="modal-body  ">

                    <div class="row">
                        <div class="col-md-12">

                            <form id="party-form" action="{{ path('edit_party') }}" method="POST"
                                  enctype="multipart/form-data">

                                <!-- party create section -->
                                <div class="card card-dashed p-4 mb-3">
                                    <div class="text-center mb-4">
                                        <h5 class="mb-0">Editar Entidad</h5>
                                    </div>
                                    <div class="row g-3">
                                        <input type="hidden" id="party-id" name="party[party_id]">
                                        <div class="col-md-12">
                                            <label for="party-name" class="form-label required"> Nombre de la
                                                Entidad </label>
                                            <input type="text" class="form-control" id="party-name-edit"
                                                   name="party[party_name]"
                                                   placeholder="Ingrese el nombre completo" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="party-identifier"
                                                   class="form-label required">Identificador </label>
                                            <input type="text" class="form-control" id="party-identifier-edit"
                                                   name="party[party_identifier]"
                                                   placeholder="Ingresar Identificador" required>
                                        </div>


                                        <div class="col-md-6">
                                            <label for="party-id-type" class="form-label required">Tipo de Identificador
                                            </label>
                                            <select class="form-select" id="party-id-type-edit"
                                                    name="party[party_id_type]"
                                                    required>
                                                <option value="" selected disabled>Seleccione...</option>
                                                {% for identificationType in identificationTypes %}
                                                    <option
                                                        value="{{ identificationType.id }}">{{ identificationType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <!-- Tipo de Entidad -->
                                        <div class="col-md-12">
                                            <label for="party-type" class="form-label required">Tipo de Entidad </label>
                                            <select class="form-select" id="party-type-edit" name="party[party_type]"
                                                    required>
                                                <option value="" selected disabled>Seleccione...</option>
                                                {% for partyType in partyTypes %}
                                                    <option value="{{ partyType.id }}">{{ partyType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        {#  <div class="float-end">
                                            <a href="javascript:void(0)" class="btn text-muted"
                                               id="add-user-party-edit"> <i
                                                    class="fas fa-plus"></i> Agregar Usuario </a>
                                        </div> #}
                                    </div>
                                </div>

                                <!-- end party create section -->

                                <!-- user create section -->
                                {#  <div class="card card-dashed p-4 mb-3 d-none" id="card-user-edit">
                                    <div class="text-center mb-4">
                                        <h5 class="mb-0">Creación de Usuario</h5>
                                    </div>
                                    <div class="row g-3">
                                        <input type="hidden" id="user-id" name="user[user_id]">
                                        <div class="col-md-12">
                                            <div class="d-flex justify-content-center mb-3">
                                                <div class="user-image-wrapper">
                                                    <img src="{{ asset('media/user.png') }}" alt="Imagen de Usuario"
                                                         id="previewImage-edit">
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-center">
                                                <button type="button" class="btn btn-secondary" id="uploadBtn-edit">
                                                    <i class="fas fa-image"></i> Seleccionar archivo
                                                </button>
                                                <input type="file" id="fileInput-edit" style="display: none;"
                                                       accept="image/*">

                                                <input type="hidden" name="user[user_avatar]" id="base64Input-edit">
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="user-username" class="form-label">Nombre de Usuario <span
                                                    class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="user-username-edit"
                                                   name="user[user_name]" placeholder="Nombre de Usuario">
                                        </div>

                                        <!-- Email -->
                                        <div class="col-md-6">
                                            <label for="user-email" class="form-label">Email <span
                                                    class="text-danger">*</span></label>
                                            <input type="email" class="form-control" id="user-email-edit"
                                                   name="user[user_email]" readonly placeholder="correo@ejemplo.com">
                                        </div>

                                        <!-- Roles Section -->
                                        <div class="col-12">
                                            <label class="form-label d-block">Roles <span
                                                    class="text-danger">*</span></label>
                                            <div class="border rounded p-3">
                                                <div class="row">
                                                    {% for role in roles %}
                                                        <div class="col-md-4 mb-2">
                                                            <div class="form-check d-flex align-items-center">
                                                                <input
                                                                    class="form-check-input me-2"
                                                                    type="checkbox"
                                                                    id="role-{{ role.id }}-edit"
                                                                    name="user-roles[]"
                                                                    value="{{ role.id }}">
                                                                <label class="form-check-label mb-0"
                                                                       for="role-{{ role.id }}">
                                                                    {{ role.textName }}
                                                                </label>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                            <small class="text-muted">Selecciona uno o más roles para el usuario</small>
                                        </div>
                                    </div>
                                </div> #}

                                <!-- end user create section -->

                                <div class="col-md-12">
                                    <div class="d-flex gap-2 justify-content-end mt-3">
                                        <button type="button" class="btn btn-secondary" id="btn-cancel">
                                            Cancelar
                                        </button>
                                        <button type="submit" class="btn btn-primary" id="btn-save">
                                            Guardar Entidad
                                        </button>
                                    </div>
                                </div>
                            </form>


                        </div>
                    </div>


                </div>
                <!--end::Modal body-->
            </div>
            <!--end::Modal content-->
        </div>
        <!--end::Modal dialog-->
    </div>

    <div class="content flex-row-fluid" id="kt_content">
        <!--begin::Navbar-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body pt-9 pb-0 p-4">
                <div class="container-fluid">
                    <div class="row g-4">

                        <div class="container my-4">
                            <div class="row g-3">

                                <div class="card-body">

                                    <!-- Tabs por rol -->
                                    <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x mb-5 fs-6">
                                        {% for partyType in partyTypes %}

                                            <li class="nav-item">
                                                <a class="nav-link
                                                        {% if loop.first %}
                                                            active
                                                        {% endif %}"
                                                   data-bs-toggle="tab"
                                                   href="#tab_party_type_{{ partyType.id }}">{{ partyType.name }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>

                                    <div class="tab-content">
                                        {% for partyType in partyTypes %}

                                            <div class="tab-pane fade
                                                {% if loop.first %}
                                                    show active
                                                {% endif %}" id="tab_party_type_{{ partyType.id }}">

                                                {% set typeOfParty = parties[partyType.id].parties %}

                                                {% if typeOfParty is empty %}
                                                    <div class="card">
                                                        <div class="card-body text-center">
                                                            <h5 class="card-title">No hay Entidades</h5>
                                                            <p class="card-text"> No hay entidades asociadas a este
                                                                tipo </p>
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <div class="table-responsive">
                                                        <table id="tabUser_{{ partyType.id }}"
                                                               class="table table-hover table-striped table-row-bordered gy-5 stylish-table mb-0 mt-2">
                                                            <thead>
                                                            <tr class="fw-semibold fs-6 text-muted">
                                                                <th>ID</th>
                                                                <th>Nombre</th>
                                                                <th>Identificador</th>
                                                                <th>Tipo de Identificador</th>
                                                                <th>Estado</th>
                                                                <th>Opciones</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            {% for party in typeOfParty %}
                                                                <tr class="jusitfy-content-center d-flow">
                                                                    <td>{{ party.id }}</td>
                                                                    <td>
                                                                        <div class="d-flex align-items-center">
                                                                            <div
                                                                                class="d-flex justify-content-start flex-column">
                                                                            <span
                                                                                class="text-dark fw-bold text-hover-primary fs-6 text-start">
                                                                                {{ party.name }}
                                                                            </span>
                                                                                <span
                                                                                    class="text-muted fw-semibold d-block fs-7 text-start">
                                                                            {% if party.activeInd %}
                                                                                <i class="fa fa-check-circle"
                                                                                   style="color: #50CD89;"></i> Activado
                                                                            {% else %}
                                                                                <i class="fa fa-window-close"
                                                                                   style="color: darkred;"></i> Desactivado
                                                                            {% endif %}
                                                                        </span>
                                                                            </div>
                                                                        </div>
                                                                    </td>
                                                                    <td>{{ party.identification }}</td>
                                                                    <td>{{ party.identificationType.name }}</td>
                                                                    <td>
                                                                        {{ party.activeInd ? 'Activo' : 'Inactivo' }}
                                                                    </td>
                                                                    <td>
                                                                        <a type="button"
                                                                           class="btn btn-secondary btn-edit-party"
                                                                           data-id="{{ party.id }}">
                                                                            <i class="bi bi-pencil-square"></i>
                                                                            Editar
                                                                        </a>
                                                                        {% if party.activeInd %}
                                                                            <a type="button"
                                                                               class="btn btn-danger btn-delete-party"
                                                                               data-id="{{ party.id }}"
                                                                               data-type="false" >
                                                                                <i class="fas fa-trash"></i>
                                                                                Eliminar
                                                                            </a>
                                                                        {% else %}
                                                                            <a type="button"
                                                                               class="btn btn-success btn-delete-party"
                                                                               data-id="{{ party.id }}"
                                                                               data-type="true" >
                                                                                <i class="fas fa-trash-restore"></i>
                                                                                Restaurar
                                                                            </a>
                                                                        {% endif %}

                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



{% endblock %}

{% block javascripts %}
    <script>

        $(document).ready(function () {
            $('#uploadBtn').click(function () {
                $('#fileInput').click();
            });

            $('#fileInput').change(function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const base64 = e.target.result;
                        $('#previewImage').attr('src', base64);   // preview
                        $('#base64Input').val(base64);           // guardar en hidden input
                    }
                    reader.readAsDataURL(file);
                }
            });

            $('#uploadBtn-edit').click(function () {
                $('#fileInput-edit').click();
            });

            $('#fileInput-edit').change(function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const base64 = e.target.result;
                        $('#previewImage-edit').attr('src', base64);   // preview
                        $('#base64Input-edit').val(base64);           // guardar en hidden input
                    }
                    reader.readAsDataURL(file);
                }
            });
        });

        $(document).on('click', '#add-user-party', function () {

            $("#card-user").removeClass('d-none');

        })

        $(document).on('click', '#add-user-party-edit', function () {

            $("#card-user-edit").removeClass('d-none');

        })

        $(document).on('click', '.btn-edit-party', function () {
            let id = $(this).data('id');

            $.ajax({
                url: '{{ path("edit_party_get") }}',
                method: 'GET',
                data: {
                    id: id
                },
                success: function (response) {

                    console.log(response.data);

                    let party = response.data.party;
                    let user = response.data.user;

                    $("#party-id").val(party.id);
                    $('#party-name-edit').val(party.name);
                    $('#party-identifier-edit').val(party.identification);
                    $("#party-id-type-edit").val(party.identificationType).trigger('change');
                    $("#party-type-edit").val(party.partyType).trigger('change');

                    if (user.email != null) {
                        $("#card-user-edit").removeClass('d-none');
                        $("#add-user-party-edit").addClass('d-none');

                        $("#user-id").val(user.id);
                        $("#user-username-edit").val(user.name);
                        $("#user-email-edit").val(user.email);
                        console.log(user.avatar)
                        if (user.avatar && user.avatar.trim() !== "") {
                            console.log(user.avatar);
                            $("#previewImage-edit").attr('src', user.avatar);
                        }

                        $("[id^='role-'][id$='-edit']").prop('checked', false);

                        user.roles.forEach(function (role) {
                            $("#role-" + role + "-edit").prop('checked', true);
                        })
                    } else {
                        $("#card-user-edit").addClass('d-none');
                        $("#add-user-party-edit").removeClass('d-none');
                    }

                    $("#kt_modal_edit_app").modal('show');
                }
            })
        })

        $(".btn-delete-party").click(function (e) {
            let id = $(this).data('id');
            let type = $(this).data('type') ? 1 : 0;

            let title;
            let text;

            if(type == true){
                title = "¿Estas Seguro de Restaurar esta Entidad?"
                text = ""
            }else{
                title = '¿Estas Seguro de Eliminar esta Entidad?'
                text = '¡Una vez eliminada no se podra recuperar!'
            }

            swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si, Eliminar'
            }).then((result) => {
                if(result.isConfirmed){
                    $.ajax({
                        url: '{{ path("delete_party") }}',
                        method: 'POST',
                        data: {
                            id: id,
                            type: type
                        },
                        success: function (response) {
                            if (response.status == true ) {
                                if(type == true){
                                    swal.fire(
                                        'Restaurado!',
                                        'La Entidad ha sido restaurada.',
                                        'success'
                                    )
                                }else{
                                    swal.fire(
                                        'Eliminado!',
                                        'La Entidad ha sido eliminada.',
                                        'success'
                                    )
                                }
                                location.reload();
                            }
                        }
                    })
                }
            })
        })
    </script>

{% endblock %}
