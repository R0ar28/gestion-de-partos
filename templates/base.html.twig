<script>

    $(document).ready(function () {
        function updateCountdown() {
            const now = Math.floor(Date.now() / 1000); // Timestamp actual en segundos

            $('.countdown').each(function () {
                const $element = $(this);
                const countdownEnd = parseInt($element.data('countdown'), 10);

                if (isNaN(countdownEnd)) {
                    $element.text("Fecha inválida").css("backgroundColor", "gray");
                    return;
                }

                const distance = countdownEnd - now;

                if (distance < 0) {
                    $element.text("Tiempo Expirado").css({backgroundColor: 'red', color: 'white'});
                    return;
                }

                const days = Math.floor(distance / (60 * 60 * 24));
                const hours = Math.floor((distance % (60 * 60 * 24)) / (60 * 60));
                const minutes = Math.floor((distance % (60 * 60)) / 60);

                $element.text(`${days}d ${hours}h ${minutes}m`)
                    .css("backgroundColor", days < 1 ? "orange" : "");
            });
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    });


