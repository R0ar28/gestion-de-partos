    function confirmCancelOrder(entityId, deletePath) {
        Swal.fire({
            title: '¿Estás seguro?',
            text: 'Esta acción no se puede deshacer',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Sí, Cancelar Orden',
            cancelButtonText: 'No'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = deletePath.replace('ENTITY_ID', entityId);
            }
        });
    }

    function confirmDelete(entityId, callback) {
        Swal.fire({
            title: '¿Estás seguro?',
            text: 'Esta acción no se puede deshacer',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Sí, eliminarlo',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                if (callback && typeof callback === 'function') {
                    callback();
                }
            }
        });
    }


    $(document).ready(function () {

        $('#resultSampleAnaly').on('shown.bs.modal', function () {
            var resultDate = $('#resultDate').val();
            if (!resultDate) {
                var currentDate = new Date();
                var formattedDate = currentDate.toISOString().split('T')[0];
                $('#resultDate').val(formattedDate);
            }
        });

        $(document).on('click', '.resultAna', function (event) {
            $('.idResultModal').html();

            event.preventDefault();

            typeAnalysisName = $(this).attr('data-typeAnalysis');
            idResult = $(this).attr('data-idResult');
            resultVal = $(this).attr('data-resultVal');
            resultDate = $(this).attr('data-resultDate');
            resultDesc = $(this).attr('data-resultDesc');
            idAnalysis = $(this).attr('data-analysisId');
            analysisUnit = $(this).attr('data-analysisUnit');

            idAnalysis = parseInt(idAnalysis);

            $('#resultVal').val(resultVal);
            $('#resultDate').val(resultDate);
            $('#resultDesc').val(resultDesc);
            $('#unitResult option').filter(function () {
                return $(this).text() === analysisUnit;
            }).prop('selected', true);

            $('.idResultModal').html('Análisis : ' + typeAnalysisName);

            $('#resultSampleAnaly').modal('show');

        });

        $(document).on('submit', '#formSampleAnalysis', function (event) {
            event.preventDefault();

            valResult = $('#resultVal');
            base64Image = $("#base64ResultFile");
            dateResult = $('#resultDate');
            descResult = $('#resultDesc');
            outOfRange = $("#outOfRangeCheck").prop('checked');
            unitResult = $('#unitResult').val()

            $.ajax({
                url: pathIndex.updateResultAnalysis.replace('_id_', idResult),
                method: 'POST',
                data: {
                    resultVal: valResult.val(),
                    resultDate: dateResult.val(),
                    resultDesc: descResult.val(),
                    base64ImageResult: base64Image.val(),
                    outOfRange: outOfRange,
                    unitResult: unitResult

                },
                success: function (data) {

                    toastr.success("Resultados de análisis ingresados correctamente");

                    var tableRow = $('#tabAnalysis tr[data-id="' + idResult + '"]');
                    tableRow.find('.resultValColumn').text($('#resultVal').val());
                    if (unitResult != 0) {
                        tableRow.find('.resultUnitAnalysis').text($('#unitResult option:selected').text());
                    }
                    tableRow.find('.resultDateColumn').text(formatDate($('#resultDate').val()));
                    tableRow.find('.fa-circle').remove();
                    if (descResult.val().trim() === '') {
                        tableRow.find('.resultDescColumn').text('Sin descripción');
                    } else {
                        tableRow.find('.resultDescColumn').text($('#resultDesc').val());
                    }

                    var updateButton = tableRow.find('.resultAna');
                    updateButton.attr('data-resultVal', valResult.val());
                    updateButton.attr('data-resultDate', dateResult.val());
                    updateButton.attr('data-resultDesc', descResult.val());


                    $('#resultSampleAnaly').modal('hide');
                    checkResults();


                },
                error: function (xhr, status, error) {
                    toastr.error('Error al actualizar el análisis.');
                }
            });

        });
    });


    function checkResults() {
        var rows = document.querySelectorAll('#tabAnalysis tbody tr');
        var reportOrderButton = document.getElementById('reportOrder');
        var showButton = true;

        rows.forEach(function (row) {
            var resultValColumn = row.querySelector('.resultValColumn');
            var resultDateColumn = row.querySelector('.resultDateColumn');
            var resultDescColumn = row.querySelector('.resultDescColumn');

            if (resultValColumn.textContent.trim() === 'Por Ingresar' ||
                resultDateColumn.textContent.trim() === 'Por Ingresar' ||
                resultDescColumn.textContent.trim() === 'Por Ingresar') {
                showButton = false;
            }
        });
        if (reportOrderButton != null) {
            if (showButton) {
                reportOrderButton.style.display = 'inline-block';
            } else {
                reportOrderButton.style.display = 'none';
            }
        }
    }

