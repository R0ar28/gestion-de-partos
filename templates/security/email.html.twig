<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <title>Correo Responsivo</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
    <style>

        table, td, div, h1, p {
            font-family: Arial, sans-serif;
        }

        .button-email {
            background-color: #01b9de;
            display: inline-block;
            font-weight: bolder;
            line-height: 1.5;
            color: #fefffd !important;
            text-align: center;
            text-decoration: none;
            vertical-align: middle;
            cursor: pointer;
            user-select: none;
            border: 1px solid transparent;
            padding: 0.375rem 0.75rem;
            font-size: 1rem;
            border-radius: 4px;
            transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out,
            border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

        @media only screen and (max-width: 600px) {
            .container {
                width: 100% !important;
                padding: 0 10px;
            }

            h1 {
                font-size: 20px !important;
                margin: 0 0 15px 0 !important;
            }

            p {
                font-size: 14px !important;
                line-height: 20px !important;
            }

            .button-email {
                font-size: 0.875rem !important;
                padding: 0.5rem 1rem !important;
            }
        }
    </style>
</head>
<body style="margin:0;padding:0;">
<table role="presentation" class="container" style="width:100%;border-collapse:collapse;border:0;border-spacing:0;">
    <tr>
        <td align="center" style="padding:0;">
            <table role="presentation" style="width:602px;border-collapse:collapse; border-spacing:0;text-align:left;
             border: outset;background:#ffffff;">
                <tr>
                    <td align="center" style="background-color: #dadce0">
                        <table>
                            <tr>
                                <td><img src="https://mujeresdenuble.cl/media/logos/logo_valio.png" alt="" width="200"
                                         style=""/>
                                </td>
                                <td></td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:36px 30px 42px 30px;">
                        <table role="presentation" style="width:100%;border-collapse:collapse;border:0;border-spacing:0;">
                            <tr>
                                <td style="padding:0 0 36px 0;color:#153643;">
                                    <h2>
                                        {{ title|default('Título') }}
                                    </h2>
                                    <p style="margin:0 0 12px 0;font-size:18px;line-height:24px;font-family:Arial,
                                        sans-serif;color: black !important;">
                                        {{ messages|raw }}
                                    </p>
                                    {% if enlace is defined and enlace is not empty %}
                                        <p style="margin:0 0 12px 0; font-size:16px; line-height:24px; font-family:Arial,
                                         sans-serif; color: black !important;">
                                            <a href="{{ enlace }}" style="color: black !important; text-decoration: none;">
                                                ¡Haz clic aquí!
                                            </a>
                                        </p>
                                    {% endif %}
                                    {% if resetUrl is defined and resetUrl is not empty %}
                                        <p style="text-align:center; padding-top: 30px">
                                            <a href="{{ resetUrl }}" class="button-email">Ir a Canal de Denuncias</a>
                                        </p>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
