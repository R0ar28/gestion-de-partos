<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('css/login_style.css') }}" rel="stylesheet">
    <script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit" async defer></script>
    <link href="{{ asset('css/denuncias.css') }}" rel="stylesheet" type="text/css"/>
    <title> Iansa Biblioteca - Inicio Sesion</title>

</head>
<body>
    <div class="container-fluid p-0">
        <div class="row no-gutters">
            <div class="col-lg-12">
                <div class="login-form p-4 d-flex align-items-center vh-100 justify-content-center ">
                    <div class="w-100 ">
                        <div class="row justify-content-center ">
                            <div class="col-lg-3 ">
                                <div>
                                    <div class="text-center mt-10">
                                        {% if error %}
                                        <div class="alert alert-danger alert-dismissible fade show mb-5">
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                            <strong>{{ error.messageKey|trans(error.messageData, 'security') }}</strong>
                                          </div>
                                    {% endif %}
                                    {% if app.user %}
                                        <div class="mb-3">
                                            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                                        </div>
                                    {% endif %}
                                        <div>
                                            <img src="{{ asset('images/logo.png') }}" alt="" class="img-fluid mb-3" width="250px">
                                        </div>
                                        <div>
                                            <h4 class="font-size-18">Bienvenido(a)</h4>
                                            <p class="text-muted">Iniciar sesión para continuar.</p>

                                        </div>
                                    </div>
                                    <div class="p-2 mt-3">
                                        <form id="loginForm" method="post">

                                            <input type="hidden" name="_token" value="kWKOIR3UFsZjKPNgWEitaIA4T8A87rK1mxsdeLpn">
                                            <div class="form-group auth-form-group-custom mb-4">
                                                <i class="fas fa-user-circle auti-custom-input-icon"></i>
                                                <label for="email">Correo electrónico</label>
                                                <input id="email" type="email" class="form-control " name="email" value="" required autocomplete="email" placeholder="Ingresar Email">
                                            </div>

                                            <div class="form-group auth-form-group-custom mb-4">
                                                <i class="fas fa-lock auti-custom-input-icon"></i>
                                                <label for="password">Contraseña</label>
                                                <input type="password" class="form-control " name="password" required autocomplete="current-password" id="password" placeholder="Ingresar Contraseña">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                            </div>

                                            {# <div class="custom-control custom-checkbox">
                                                <input type="checkbox" class="custom-control-input" id="customControlInline">
                                                <label class="custom-control-label" for="customControlInline">Recordar</label>
                                            </div> #}


                                            <div class="mt-4 text-center">
                                                <button class="btn btn-success" type="submit">Iniciar Sesión</button>
                                            </div>
                                        </form>
                                    </div>

                                    <div class="mt-4 text-center">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>

    <div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="forgotPasswordModalLabel">Recuperar Contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" style="text-align: -webkit-center">
                    <form id="forgotPasswordForm" method="POST" action="{{ path('app_send_new_password') }}">
                        <div class="mb-3">
                            <label for="forgotPassEmail" class="form-label">Ingresa tu correo electrónico</label>
                            <input type="email" class="form-control" id="forgotPassEmail" name="forgotPassEmail" placeholder="Correo electrónico" required>
                        </div>

                        {#  <div class="mb-3">
                            <div class="g-recaptcha" id="recaptchaForgotPassword"></div>
                        </div>#}

                        <button type="submit" class="btn custom-btn">Enviar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script>

        $(document).ready(function () {
            const floatingHelp = document.getElementById('floatingHelp');

            floatingHelp.addEventListener('click', function (event) {
                event.stopPropagation();
                const helpCard = this.querySelector('.help-card');
                helpCard.classList.toggle('show');
            });

            document.addEventListener('click', function (event) {
                if (!floatingHelp.contains(event.target)) {
                    const helpCard = floatingHelp.querySelector('.help-card');
                    helpCard.classList.remove('show');
                }
            });
        });
    </script>

    <script>

        {% for flashMessage in app.session.flashbag.get('error') %}

        Swal.fire({
            text: "{{ flashMessage }}",
            icon: "error",
            timer: 2000,
            showConfirmButton: false,
            showCancelButton: false,
        });
        {% endfor %}

        {% for flashMessage in app.session.flashbag.get('success') %}

        Swal.fire({
            text: "{{ flashMessage }}",
            icon: "success",
            timer: 2000,
            showConfirmButton: false,
            showCancelButton: false,
        });
        {% endfor %}

        {% for flashMessage in app.session.flashbag.get('info') %}

        Swal.fire({
            text: "{{ flashMessage }}",
            icon: "info",
            timer: 2000,
            showConfirmButton: false,
            showCancelButton: false,
        });

        {% endfor %}


    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const emailInput = document.getElementById('email');
            const checboxRecordar = document.getElementById('customControlInline');

            if (localStorage.getItem('emailRecordar')) {
                emailInput.value = localStorage.getItem('emailRecordar');
                checboxRecordar.checked = true;
            }


            checboxRecordar.addEventListener('change', function () {
                if (this.checked) {
                    localStorage.setItem('emailRecordar', emailInput.value);
                } else {
                    localStorage.removeItem('emailRecordar');
                }
            });


            emailInput.addEventListener('input', function () {
                if (checboxRecordar.checked) {
                    localStorage.setItem('emailRecordar', emailInput.value);
                }
            });
        });
        </script>


    <script>

        const captchaResolved = {};
        const widgetIds = {};

        function verifyCallback(formType) {
            return function(response) {
                if (response) {
                    captchaResolved[formType] = true;
                }
            };
        }

        window.onloadCallback = function() {

            const attempts = parseInt({{ attempts|default(0) }}, 10);

            const captchaConfigs = [
                { id: 'recaptchaLogin', type: 'loginForm', condition: () => attempts >= 3 }
            ];

            captchaConfigs.forEach(({ id, type, condition }) => {
                if (document.getElementById(id) && condition()) {
                    captchaResolved[type] = false;
                    widgetIds[type] = grecaptcha.render(id, {
                        'sitekey': '6LeYRo0qAAAAAG25_WFZztMddbaWpDo19NfJ2Jsg',
                        'callback': verifyCallback(type)
                    });
                }
            });

            const forgotPasswordModal = document.getElementById('forgotPasswordModal');
            if (forgotPasswordModal) {
                forgotPasswordModal.addEventListener('shown.bs.modal', function () {

                    {#if (!widgetIds['forgotPasswordForm']) {
                        captchaResolved['forgotPasswordForm'] = false;
                        widgetIds['forgotPasswordForm'] = grecaptcha.render('recaptchaForgotPassword', {
                            'sitekey': '6LeYRo0qAAAAAG25_WFZztMddbaWpDo19NfJ2Jsg',
                            'callback': verifyCallback('forgotPasswordForm')
                        });
                    }#}
                });
            }
        };

        function validateRecaptcha(formType) {
            const widgetId = widgetIds[formType];

            const recaptchaResponse = grecaptcha.getResponse(widgetId);
            if (recaptchaResponse.length === 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'ReCAPTCHA requerido',
                    text: 'Por favor, completa el reCAPTCHA antes de enviar el formulario.'
                });
                return false;
            }
            return true;
        }

        document.addEventListener("DOMContentLoaded", function() {
            const formConfigs = [
                { formId: 'loginForm', captchaType: 'loginForm', attemptsCheck: true },
                { formId: 'forgotPasswordForm', captchaType: 'forgotPasswordForm', attemptsCheck: false }
            ];

            formConfigs.forEach(({ formId, captchaType, attemptsCheck }) => {
                const form = document.getElementById(formId);
                if (form) {
                    form.addEventListener('submit', function(e) {
                        if (attemptsCheck) {
                            const attempts = {{ attempts }};
                            if (attempts < 3) {
                                return;
                            }
                        }

                        {#if (!validateRecaptcha(captchaType)) {
                            e.preventDefault();
                        }#}
                    });
                }
            });
        });

    </script>

</body>
</html>
