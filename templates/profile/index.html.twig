{% extends 'base.html.twig' %}

{% block title %}Mi Perfil{% endblock %}

{% set titlePage = 'Perfil' %}


{% block breadcrumb %}

    <li class="breadcrumb-item text-white opacity-75">
        <a href="{{ path('app_dash') }}" class="text-white text-hover-primary">Perfil</a>
    </li>


{% endblock %}


{% block body %}

    <div class="content flex-row-fluid" id="kt_content">
        <!--begin::Navbar-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body pt-9 pb-0">
                <!--begin::Details-->
                <div class="d-flex flex-wrap flex-sm-nowrap mb-3">
                    <!--begin: Pic-->
                    <div class="me-7 mb-4">


                        <form role="form" id="saveAvatar" action="{{ path('profile_avatar_update') }}"
                              method="POST" novalidate="" enctype="multipart/form-data">


                            <div class="image-input image-input-outline" data-kt-image-input="true"
                                 style="background-image: url({{ url('profile_avatar', { 'id': app.user.avatar|default('none') } ) }})">
                                <!--begin::Preview existing avatar-->
                                <div class="image-input-wrapper w-125px h-125px"
                                     style="background-image: url({{ url('profile_avatar', { 'id': app.user.avatar|default('none') } ) }});"></div>
                                <div
                                    class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-success rounded-circle border border-4 border-white h-20px w-20px"></div>
                                <!--end::Preview existing avatar-->
                                <!--begin::Label-->
                                <label
                                    class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
                                    data-kt-image-input-action="change" data-bs-toggle="tooltip" title=""
                                    data-bs-original-title="Cambiar fotos de perfil">
                                    <i class="bi bi-pencil-fill fs-7"></i>
                                    <!--begin::Inputs-->
                                    <input type="file" id="avatarProfile" name="avatar" accept=".png, .jpg, .jpeg">
                                    <input type="hidden" name="avatar_remove" value="0">
                                    <!--end::Inputs-->
                                </label>
                                <!--end::Label-->

                            </div>
                            <!--end::Image input-->
                            <!--begin::Hint-->
                        </form>
                    </div>
                    <!--end::Pic-->
                    <!--begin::Info-->
                    <div class="flex-grow-1">
                        <!--begin::Title-->
                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                            <!--begin::User-->
                            <div class="d-flex flex-column">
                                <!--begin::Name-->
                                <div class="d-flex align-items-center mb-2">
                                    <a href="#"
                                       class="text-gray-900 text-hover-primary fs-2 fw-bolder me-1">{{ user.personName }}</a>
                                    <a href="#">
                                        <!--begin::Svg Icon | path: icons/duotune/general/gen026.svg-->
                                        <span class="svg-icon svg-icon-1 svg-icon-primary">
																<svg xmlns="http://www.w3.org/2000/svg" width="24px"
                                                                     height="24px" viewBox="0 0 24 24">
																	<path
                                                                        d="M10.0813 3.7242C10.8849 2.16438 13.1151 2.16438 13.9187 3.7242V3.7242C14.4016 4.66147 15.4909 5.1127 16.4951 4.79139V4.79139C18.1663 4.25668 19.7433 5.83365 19.2086 7.50485V7.50485C18.8873 8.50905 19.3385 9.59842 20.2758 10.0813V10.0813C21.8356 10.8849 21.8356 13.1151 20.2758 13.9187V13.9187C19.3385 14.4016 18.8873 15.491 19.2086 16.4951V16.4951C19.7433 18.1663 18.1663 19.7433 16.4951 19.2086V19.2086C15.491 18.8873 14.4016 19.3385 13.9187 20.2758V20.2758C13.1151 21.8356 10.8849 21.8356 10.0813 20.2758V20.2758C9.59842 19.3385 8.50905 18.8873 7.50485 19.2086V19.2086C5.83365 19.7433 4.25668 18.1663 4.79139 16.4951V16.4951C5.1127 15.491 4.66147 14.4016 3.7242 13.9187V13.9187C2.16438 13.1151 2.16438 10.8849 3.7242 10.0813V10.0813C4.66147 9.59842 5.1127 8.50905 4.79139 7.50485V7.50485C4.25668 5.83365 5.83365 4.25668 7.50485 4.79139V4.79139C8.50905 5.1127 9.59842 4.66147 10.0813 3.7242V3.7242Z"
                                                                        fill="#00A3FF"></path>
																	<path class="permanent"
                                                                          d="M14.8563 9.1903C15.0606 8.94984 15.3771 8.9385 15.6175 9.14289C15.858 9.34728 15.8229 9.66433 15.6185 9.9048L11.863 14.6558C11.6554 14.9001 11.2876 14.9258 11.048 14.7128L8.47656 12.4271C8.24068 12.2174 8.21944 11.8563 8.42911 11.6204C8.63877 11.3845 8.99996 11.3633 9.23583 11.5729L11.3706 13.4705L14.8563 9.1903Z"
                                                                          fill="white"></path>
																</svg>
															</span>
                                        <!--end::Svg Icon-->
                                    </a>
                                    <a href="#" class="btn btn-sm btn-light-success fw-bolder ms-2 fs-8 py-1 px-3"
                                       data-bs-toggle="modal" data-bs-target="#kt_modal_upgrade_plan">

                                        {% for role in  user.rolesString %}
                                            <span style="font-size: 10px;">{{ role }}  </span>
                                        {% endfor %}


                                    </a>
                                </div>
                                <!--end::Name-->
                                <!--begin::Info-->
                                <div class="d-flex flex-wrap fw-bold fs-6 mb-4 pe-2">


                                    <a href="#" class="d-flex align-items-center text-gray-400 text-hover-primary mb-2">
                                        <!--begin::Svg Icon | path: icons/duotune/communication/com011.svg-->
                                        <span class="svg-icon svg-icon-4 me-1">
															<svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                                 height="24" viewBox="0 0 24 24" fill="none">
																<path opacity="0.3"
                                                                      d="M21 19H3C2.4 19 2 18.6 2 18V6C2 5.4 2.4 5 3 5H21C21.6 5 22 5.4 22 6V18C22 18.6 21.6 19 21 19Z"
                                                                      fill="currentColor"></path>
																<path
                                                                    d="M21 5H2.99999C2.69999 5 2.49999 5.10005 2.29999 5.30005L11.2 13.3C11.7 13.7 12.4 13.7 12.8 13.3L21.7 5.30005C21.5 5.10005 21.3 5 21 5Z"
                                                                    fill="currentColor"></path>
															</svg>
														</span>
                                        <!--end::Svg Icon--> {{ app.user.email }}</a>
                                </div>
                                <!--end::Info-->
                            </div>
                            <!--end::User-->
                            <!--begin::Actions-->
                            <div class="d-flex my-4">

                                <a href="#" class="btn btn-primary me-2" data-bs-toggle="modal"
                                   data-bs-target="#kt_modal_1">Cambiar Contraseña</a>

                                <div class="modal fade" tabindex="-1" id="kt_modal_1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h3 class="modal-title">Cambiar Contraseña</h3>

                                                <!--begin::Close-->
                                                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2"
                                                     data-bs-dismiss="modal" aria-label="Close">
                                                    <span class="svg-icon svg-icon-1"></span>
                                                </div>
                                                <!--end::Close-->
                                            </div>

                                            <!--begin::Form-->
                                            <form role="form" class="mx-auto w-100 mw-700px pt-2 pb-10"
                                                  id="changePassword"
                                                  novalidate="novalidate" action="{{ path('profile_password_update') }}"
                                                  method="POST" enctype="multipart/form-data">
                                                <!--begin::Settings-->
                                                <div class="current" data-kt-stepper-element="content">
                                                    <!--begin::Wrapper-->

                                                    <div class="card-body d-flex flex-column">
                                                        <!--begin::Name-->


                                                        <div class="fv-row mb-8">
                                                            <label
                                                                class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                                                                <span class="required">Contraseña Actual</span>
                                                            </label>
                                                            <input type="password" name="passOld" id="currentPassword"
                                                                   required
                                                                   class="form-control form-control-solid"/>
                                                        </div>

                                                        <div class="fv-row mb-8">
                                                            <label
                                                                class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                                                                <span class="required">Nueva Contraseña</span>
                                                            </label>
                                                            <input type="password" name="passNew" id="newPassword"
                                                                   required
                                                                   class="form-control form-control-solid"/>
                                                        </div>


                                                        <!--begin::Actions-->
                                                        <div class="d-flex flex-stack justify-content-center">
                                                            <div class="d-flex flex-stack justify-content-center">

                                                                <button type="submit"
                                                                        class="btn btn-lg btn-success fw-bolder"
                                                                        data-kt-element="settings-next">
                                                                    <span class="indicator-label">Actualizar</span>
                                                                </button>
                                                            </div>
                                                            <!--end::Actions-->
                                                        </div>
                                                        <!--end::Wrapper-->

                                                    </div>

                                                    <!--end::Wrapper-->
                                                </div>
                                                <!--end::Settings-->
                                            </form>
                                            <!--end::Form-->


                                        </div>
                                    </div>
                                </div>


                            </div>
                            <!--end::Actions-->
                        </div>
                        <!--end::Title-->
                        <!--begin::Stats-->

                        <!--end::Stats-->
                    </div>
                    <!--end::Info-->
                </div>

            </div>
        </div>


        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="kt_tab_pane_1" role="tabpanel">


                <form role="form" id="saveDataTab1" action="{{ path('profile_update') }}"
                      method="POST" novalidate="" enctype="multipart/form-data">


                    <div class="card ">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h3>Datos de Usuario</h3>


                                    <div class="form-floating mb-7">
                                        <input type="text" class="form-control" name="profile[fullName]"
                                               value="{{ user.personName }}" required/>
                                        <label for="floatingInput">Nombre *</label>
                                    </div>


                                    <h3>Información de Contacto</h3>


                                    <div class="form-floating mb-7">
                                        <input type="text" id="emailPro" class="form-control  " disabled
                                               name="profile[email]"
                                               value="{{ app.user.email }} "/>
                                        <label for="floatingInput">Correo *</label>
                                    </div>


                                </div>

                            </div>


                        </div>

                        <div class="card-footer text-end">

                            <a href="javascript:void(0)" class="btn btn-success me-2" id="saveProfile">Actualizar
                                Perfil</a>

                        </div>


                    </div>

                </form>

            </div>
        </div>


    </div>






{% endblock %}



{% block javascripts %}


    <script src="{{ asset('plugins/custom/ckeditor/ckeditor-classic.bundle.js') }}  "></script>


    <script>


        Inputmask({
            "mask": "+56999999999",
        }).mask("#phoneProfile");


        Inputmask({
            mask: "*{1,20}[.*{1,20}][.*{1,20}][.*{1,20}]@*{1,20}[.*{2,6}][.*{1,2}]",
            greedy: false,
            onBeforePaste: function (pastedValue, opts) {
                pastedValue = pastedValue.toLowerCase();
                return pastedValue.replace("mailto:", "");
            },
            definitions: {
                "*": {
                    validator: '[0-9A-Za-z!#$%&"*+/=?^_`{|}~\-]',
                    cardinality: 1,
                    casing: "lower"
                }
            }
        }).mask("#emailPro");


        $('#saveProfile').on('click', function (e) {

            $('#saveDataTab1').submit();

        });


        $('#avatarProfile').on('change', function (e) {

            $('#saveAvatar').submit();

        });


        $(document).on('change', '.selectedRegion', function (event) {

            id = regionSearch();

            $('.selectedCommune').val(id);

        });


        function regionSearch() {

            regionId = $('.selectedRegion option:selected ').val();

            id = 1;

            $.each($('.selectedCommune option '), function (index, value) {

                if ($(this).attr('data-region') == regionId) {
                    id = $(this).val();
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });


            return id;
        }


        regionSearch();

    </script>



{% endblock %}



