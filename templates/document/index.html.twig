{% extends 'base.html.twig' %}

{% block title %}Documentos{% endblock %}

{% set documentActive = 'active' %}

{% block body %}

    <div class="modal fade" id="kt_modal_create_app" tabindex="-1" style="display: none;" aria-hidden="true">
        <!--begin::Modal dialog-->
        <div class="modal-dialog modal-dialog-centered mw-900px">
            <!--begin::Modal content-->
            <div class="modal-content">

                <div class="modal-header">

                    <h2>Nuevo Documento</h2>

                    <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">

                        <span class="svg-icon svg-icon-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1"
                                      transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                                <rect x="7.41422" y="6" width="16" height="2" rx="1"
                                      transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
                            </svg>
                        </span>
                    </div>

                </div>

                <div class="modal-body  ">

                    <form role="form" action="{{ path('app_new_document') }}" id="uploadForm"
                          method="POST" enctype="multipart/form-data">

                        <div class="row">
                            <div class="col-md-12">


                                <div class="card card-dashed p-3 mb-3">
                                    <div class="text-center">
                                        <h5> Asignar Entidad</h5>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 mb-2">
                                            <label for="party-type" class="form-label">Tipo de Entidad</label>
                                            <select class="form-select" name="party-type" id="party-type" required>
                                                <option value="" selected disabled>Seleccione un Tipo de Entidad
                                                </option>
                                                {% for partyType in partyTypes %}
                                                    <option value="{{ partyType.id }}">{{ partyType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-12">
                                            <label for="partySelect" class="form-label" id="party-label">Entidad</label>
                                            <select class="form-select" name="party" id="partySelect" required>
                                                <option value="">Seleccione una Entidad</option>

                                            </select>
                                        </div>
                                        {# <div class="float-start">

                                            <a href="javascript:void(0)" class="btn btn-sm text-muted" id="btn-add-party">
                                                <i class="fas fa-plus"> </i> Agregar Entidad
                                            </a>
                                        </div>

                                        <div id="form-add-party" class="d-none">
                                            <form>
                                                <div class="mb-3">
                                                    <label for="party-name" class="form-label">Nombre de la
                                                        Entidad</label>
                                                    <input type="text" class="form-control" id="party-name"
                                                           name="party-name" placeholder="Ingrese el nombre" required>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="party-id" class="form-label">Identificador</label>
                                                    <input type="text" class="form-control" id="party-id"
                                                           name="party-id" placeholder="Ingrese el identificador"
                                                           required>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="id-type" class="form-label">Tipo de
                                                        Identificador</label>
                                                    <select class="form-select" id="id-type" name="id-type" required>
                                                        <option value="" selected disabled>Seleccione el tipo</option>
                                                        <option value="rut">RUT</option>
                                                        <option value="dni">DNI</option>
                                                        <option value="passport">Pasaporte</option>
                                                        <option value="tax-id">Tax ID</option>
                                                        <option value="other">Otro</option>
                                                    </select>
                                                </div>

                                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                                    <button type="button" class="btn btn-secondary" id="btn-cancel">
                                                        Cancelar
                                                    </button>
                                                    <button type="submit" class="btn btn-primary" id="btn-save">
                                                        Guardar
                                                    </button>
                                                </div>
                                            </form>
                                        </div> #}
                                    </div>

                                </div>


                                <div class="card card-dashed p-3 mb-3">
                                    <div class="text-center">
                                        <h5> Datos del Documentos</h5>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label for="document-name" class="form-label">Nombre del Documento</label>
                                            <input type="text" class="form-control" id="document-name"
                                                   name="document-name" placeholder="Ingrese el nombre" required>
                                        </div>
                                        <div class="col-md-12">
                                            <label for="document-name" class="form-label">Descripción del
                                                Documento</label>
                                            <textarea name="description-document" id="description-document" cols="30"
                                                      rows="5" class="form-control"></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="documentType" class="form-label">Tipo de Documento</label>
                                            <select class="form-select" name="documentType" id="documentType" required>
                                                <option value="" disabled>Seleccione un Tipo de Documento</option>
                                                {% for documentType in documentsType %}
                                                    <option
                                                        value="{{ documentType.id }}">{{ documentType.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="documentFile" class="form-label">Archivo</label>
                                            <input type="file" class="form-control" id="documentFile"
                                                   name="documentFile"
                                                   required>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <input type="submit" class="btn btn-success" value="Subir Documento">
                        </div>
                    </form>

                </div>
                <!--end::Modal body-->
            </div>
            <!--end::Modal content-->
        </div>
        <!--end::Modal dialog-->
    </div>

    <div class="modal fade" id="kt_modal_edit_app" tabindex="-1" style="display: none;" aria-hidden="true">
        <!--begin::Modal dialog-->
        <div class="modal-dialog modal-dialog-centered mw-900px">
            <!--begin::Modal content-->
            <div class="modal-content">

                <div class="modal-header">

                    <h2>Nuevo Documento</h2>

                    <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">

                        <span class="svg-icon svg-icon-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1"
                                      transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                                <rect x="7.41422" y="6" width="16" height="2" rx="1"
                                      transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
                            </svg>
                        </span>
                    </div>

                </div>

                <div class="modal-body  ">

                    <form role="form" action="{{ path('app_edit_document') }}" id="uploadForm"
                          method="POST" enctype="multipart/form-data">

                        <div class="row">
                            <div class="col-md-12">


                                <!-- Datos de la Entidad -->
                                <div class="card card-dashed p-3 mb-3">
                                    <div class="text-center">
                                        <h4 id="data-party-title"></h4>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 ">
                                            <div class="d-flex flex-column">
                                                <h5 class="fw-semibold" id="party-name-edit"></h5>
                                                <span class="text-muted" id="party-type-edit"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <div class="d-inline-flex">
                                                <span class="fw-bold" id="party-identificator-type-edit"></span> <small
                                                    class="" id="party-identificator-edit"> </small>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Fin Datos de la Entidad -->

                                <!-- Datos del Documento -->
                                <div class="card card-dashed p-3 mb-3">
                                    <h5 class="mb-0 text-center mb-3">
                                        Datos del Documento
                                    </h5>

                                    <!-- aqui va el id del documento -->
                                    <input type="hidden" name="document-id-edit" id="document-id-edit">
                                    <!-- aqui va el id del documento -->

                                    <div class="row align-items-center">
                                        <!-- Icono + nombre documento -->
                                        <div class="col-md-3 text-center border-end">
                                            <div class="d-flex align-items-center justify-content-center mb-4"
                                                 id="document-icon">

                                            </div>
                                            <label for="document-name-edit" class="form-label"> Nombre del
                                                Documento</label>
                                            <input type="text" class="form-control text-center fw-bold"
                                                   id="document-name-edit" name="document-name-edit">
                                        </div>

                                        <!-- Detalles -->
                                        <div class="col-md-9">
                                            <dl class="row mb-0">


                                                <dt class="col-sm-4">Tipo:</dt>
                                                <dd class="col-sm-8" id="document-type-edit"></dd>

                                                <dt class="col-sm-4">Creado el:</dt>
                                                <dd class="col-sm-8" id="document-created-edit"></dd>
                                                <dd class="col-sm-12">
                                                    <label for="document-description-edit" class="form-label">
                                                        Descripcion del Documento</label>
                                                    <textarea class="form-control" rows="2"
                                                              id="document-description-edit" name="document-description-edit">Documento firmado por ambas partes</textarea>
                                                </dd>

                                            </dl>
                                        </div>
                                    </div>
                                </div>

                                <!-- Fin Datos del Documento -->

                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <input type="submit" class="btn btn-success" value="Subir Documento">
                        </div>
                    </form>

                </div>
                <!--end::Modal body-->
            </div>
            <!--end::Modal content-->
        </div>
        <!--end::Modal dialog-->
    </div>

    <div class="content flex-row-fluid" id="kt_content">
        <!--begin::Navbar-->
        <div class="card mb-5 mb-xl-10">
            <div class="card-body pt-9 pb-0 p-4">
                <div class="container-fluid">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <div
                                class="d-flex flex-wrap flex-sm-nowrap justify-content-end align-items-center mb-3 mb-xl-0">
                                <button class="btn btn-secondary btn-sm" data-bs-toggle="modal"
                                        data-bs-target="#kt_modal_create_app"><i class="bi bi-upload"></i> Subir
                                    Documento
                                </button>

                            </div>
                        </div>

                        <div class="container my-4">
                            <div class="row g-3">
                                <table class="table table-sm align-middle dataTableOn   ">
                                    <thead class="table-light">
                                    <tr class="fw-bold">
                                        <th>Documento</th>
                                        <th>Tipo Documento</th>
                                        <th>Propietario</th>
                                        <th>Detalles</th>
                                        <th>Opciones</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for document in documents %}

                                        {% set icons = {
                                            'application/vnd.openxmlformats-officedocument.wordprocessingml.document': {
                                                'file': 'doc.png',
                                                'alt': 'Documento Word'
                                            },
                                            'application/vnd.openxmlformats-officedocument.presentationml.presentation': {
                                                'file': 'ppt.png',
                                                'alt': 'Documento PowerPoint'
                                            },
                                            'application/pdf': {
                                                'file': 'pdf.png',
                                                'alt': 'Documento PDF'
                                            },
                                            'application/vnd.ms-excel': {
                                                'file': 'xls.png',
                                                'alt': 'Documento Excel'
                                            },
                                            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': {
                                                'file': 'xls.png',
                                                'alt': 'Documento Excel'
                                            },
                                            'image/png': {
                                                'file': 'img.png',
                                                'alt': 'Imagen PNG'
                                            },
                                            'image/jpeg': {
                                                'file': 'img.png',
                                                'alt': 'Imagen JPEG'
                                            }
                                        } %}

                                        {% set icon = icons[document.file_type]|default({'file':'file.png','alt':'Archivo'}) %}

                                        <tr>
                                            <!-- Documento (icono + nombre) -->
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="{{ asset('media/icons/documents/' ~ icon.file) }}"
                                                         class="me-2"
                                                         style="width: 24px; height: auto;"
                                                         alt="{{ icon.alt }}"/>
                                                    <div class="d-flex flex-column">
                                                        <span
                                                            class="fw-semibold">{{ document.name|default(document.file_name) }}</span>
                                                        <small class="text-muted">{{ icon.alt }}</small>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Tipo documento -->
                                            <td>{{ document.document_type_name }}</td>

                                            <!-- Propietario -->
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold">{{ document.party_name }}</span>
                                                    <small
                                                        class="text-muted">{{ document.party_type_name }}</small>
                                                </div>
                                            </td>

                                            <!-- Detalles estilo OneDrive -->
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <small class="text-muted">
                                                        Subido el {{ document.createdAt|date('d/m/Y H:i') }}
                                                    </small>
                                                    {% if document.updatedAt %}
                                                        <small class="text-muted">
                                                            Actualizado el {{ document.updatedAt|date('d/m/Y H:i') }}
                                                            por <span
                                                                class="fw-semibold">{{ document.user_name }}</span>
                                                        </small>
                                                    {% endif %}
                                                </div>
                                            </td>

                                            <td>

                                                <a href="#"
                                                   class="btn btn-sm btn-secondary">
                                                    <i class="bi bi-download"></i> Descargar
                                                </a>
                                                <a href="javascript:void(0)"
                                                   class="btn btn-sm btn-success btn-edit-document"
                                                   data-id="{{ document.id }}">
                                                    <i class="bi bi-pencil"></i> Editar
                                                </a>
                                                <a href="#"
                                                   class="btn btn-sm btn-danger btn-delete-document"
                                                   data-id="{{ document.id }}">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </a>

                                            </td>
                                        </tr>

                                    {% endfor %}
                                    </tbody>
                                </table>


                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}

    <script>


        $(document).on('change', '#party-type', function () {
            let val = $(this).val();
            let name = $(this).find('option:selected').text();

            $.ajax({
                url: "{{ path('search_party_by_party_type') }}",
                method: 'GET',
                data: {
                    id: val
                },
                success: function (response) {

                    $("#party-label").text(name)

                    $("#partySelect").empty();
                    $("#partySelect").append('<option value="" selected disabled>Seleccione una Opción </option>')
                    response.data.forEach(element => {
                        $("#partySelect").append(`<option value="${element.id}">${element.identification} - ${element.name}</option>`)
                    })

                },
                error: function (xhr, status, error) {
                    console.error("Error en la petición:", error);
                }
            });
        });

        $(document).on('click', '.btn-edit-document', function () {

            let id = $(this).data('id');

            $.ajax({
                url: "{{ path('app_edit_get') }}",
                method: 'GET',
                data: {
                    id: id
                },
                success: function (response) {

                    let data = response.data;

                    $("#data-party-title").text('Datos ' + data.party.partyType);

                    $("#party-name-edit").text(data.party.name);
                    $("#party-type-edit").text(data.party.partyType);

                    $("#party-identificator-type-edit").text(data.party.identificationType);
                    $("#party-identificator-edit").text(': ' + data.party.identification);

                    let fileData = agregateIconFile(data.file.type);

                    console.log(fileData);

                    $("#document-icon").append('<img src="' + fileData.icon + '" alt="' + fileData.alt + '" style="width:60px;height:auto;">');
                    $("#document-name-edit").val(data.document.name);
                    $("#document-type-edit").text(fileData.alt);
                    $("#document-created-edit").text(data.document.createdAt);
                    $("#document-description-edit").val(data.document.description);
                    $("#document-id-edit").val(data.document.id);

                    $("#kt_modal_edit_app").modal('show');

                }
            })

        });

        function agregateIconFile(type) {
            let icon = '';
            let alt = 'Archivo No Identificado';

            if (type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') {
                alt = 'Documento Word';
                icon = '{{ asset('media/icons/documents/doc.png') }}';
            } else if (type === 'application/vnd.openxmlformats-officedocument.presentationml.presentation') {
                alt = 'Documento PowerPoint';
                icon = '{{ asset('media/icons/documents/ppt.png') }}';
            } else if (type === 'application/pdf') {
                alt = 'Documento PDF';
                icon = '{{ asset('media/icons/documents/pdf.png') }}';
            } else if (type === 'application/vnd.ms-excel') {
                alt = 'Documento Excel';
                icon = '{{ asset('media/icons/documents/xls.png') }}';
            } else if (type === 'image/png' || type === 'image/jpeg') {
                alt = 'Imagen';
                icon = '{{ asset('media/icons/documents/img.png') }}';
            } else {
                icon = '{{ asset('media/icons/documents/file.png') }}';
            }

            return {icon, alt};
        }



        {#  $(document).on('click', '#btn-add-party', function (){

            $("#form-add-party").removeClass('d-none');
            $(this).hide();

        }) #}

    </script>


{% endblock %}
